{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "lanchonete-2",
  "main": "worker-admin-app.js",
  "compatibility_date": "2026-08-27",
  "keep_vars": true,
  "vars": {
    "ADMIN_PASSWORD_SHA256": "3c1ff0e77623f56bdf0eda50d37b7c3568ba4c0a17d87763c50d46fe8dcfae1d",
    "ROBOT_WEBHOOK_TOKEN_SHA256": "45e6e5656d94c7a39323efbd247cb6ac688a336419dc30c9edefb543617cae0f",
    "ROBOT_SERVICE_URL": "https://lanchonete-2-whatsapp-production.up.railway.app/instances/lanchonete-2-whatsapp",
    "FCM_PROJECT_ID": "lanchonete-admin",
    "FCM_ANDROID_API_KEY": "AIzaSyBxBWHnh0y5sExe81CIoQ6cV6czDFIHDGs",
    "FCM_ANDROID_APP_ID": "1:35803389315:android:2d8d6884073057cb05aab6",
    "FCM_SENDER_ID": "35803389315",
    "SITE_STYLE_VARIANT": "bold",
    "SITE_DEFAULT_NAME": "Lanchonete 2",
    "SITE_DEFAULT_SUBTITLE": "Peça pelo celular",
    "SITE_DEFAULT_HERO_TITLE": "Escolheu.\nPediu. Chegou.",
    "SITE_DEFAULT_HERO_TEXT": "Monte seu pedido em poucos passos e envie tudo pronto para a lanchonete.",
    "SITE_DEFAULT_PRIMARY": "#1746a2",
    "SITE_DEFAULT_ACCENT": "#ffc857",
    "SITE_DEFAULT_BACKGROUND": "#eef4ff",
    "SITE_DEFAULT_SURFACE": "#ffffff",
    "SITE_DEFAULT_TEXT": "#10204b",
    "SITE_DEFAULT_HERO_IMAGE": "/assets/hero-lanchonete-2.webp"
  },
  "kv_namespaces": [
    {
      "binding": "PROMOTIONS"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "APP_STORAGE",
        "class_name": "AppStorage"
      }
    ]
  },
  "exports": {
    "AppStorage": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  }
}
