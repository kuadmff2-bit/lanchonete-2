{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "lanchonete-2",
  "main": "worker-admin-app.js",
  "compatibility_date": "2026-08-27",
  "keep_vars": true,
  "secrets": {
    "required": ["ADMIN_PASSWORD"]
  },
  "vars": {
    "FCM_PROJECT_ID": "lanchonete-admin",
    "FCM_ANDROID_API_KEY": "AIzaSyBxBWHnh0y5sExe81CIoQ6cV6czDFIHDGs",
    "FCM_ANDROID_APP_ID": "1:35803389315:android:2d8d6884073057cb05aab6",
    "FCM_SENDER_ID": "35803389315"
  },
  "kv_namespaces": [
    {
      "binding": "PROMOTIONS"
    }
  ],
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  }
}
